generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOSEN
  MAHASISWA
}

enum StatusPengajuan {
  MENUNGGU
  DITERIMA
  DITOLAK
}

enum StatusBab {
  BELUM_UPLOAD
  MENUNGGU_REVIEW
  PERLU_REVISI
  ACC
}

enum FaseBimbingan {
  BAB_1_3
  SEMPRO
  BAB_4_5
  SELESAI
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          Role
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  dosen         Dosen?
  mahasiswa     Mahasiswa?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Dosen {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama           String
  nip            String   @unique
  prodi          String
  isActive       Boolean  @default(true)
  qrCodeUrl      String?
  qrCodePublicId String?
  pengajuan      Pengajuan[] @relation("Pembimbing1")
  pengajuan2     Pengajuan[] @relation("Pembimbing2")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Mahasiswa {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama      String
  nim       String    @unique
  prodi     String
  angkatan  Int
  pengajuan Pengajuan?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Pengajuan {
  id             String          @id @default(cuid())
  mahasiswaId    String          @unique
  mahasiswa      Mahasiswa       @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  dosenId        String
  dosen          Dosen           @relation("Pembimbing1", fields: [dosenId], references: [id])
  dosenId2       String?
  dosen2         Dosen?          @relation("Pembimbing2", fields: [dosenId2], references: [id])
  judulSkripsi   String
  skFileUrl      String
  skFilePublicId String
  status         StatusPengajuan @default(MENUNGGU)
  fase           FaseBimbingan   @default(BAB_1_3)
  qrTerkirim     Boolean         @default(false)
  qrTerkirimAt   DateTime?
  catatanDosen   String?
  dokumen        Dokumen[]
  notifikasi     Notifikasi[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Dokumen {
  id           String      @id @default(cuid())
  pengajuanId  String
  pengajuan    Pengajuan   @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  nomorBab     Int
  judulBab     String
  fileUrl      String
  filePublicId String
  status       StatusBab   @default(MENUNGGU_REVIEW)
  versi        Int         @default(1)
  komentar     Komentar[]
  dosenFiles   DosenFile[]
  uploadedAt   DateTime    @default(now())
  reviewedAt   DateTime?
}

model DosenFile {
  id           String   @id @default(cuid())
  dokumenId    String
  dokumen      Dokumen  @relation(fields: [dokumenId], references: [id], onDelete: Cascade)
  dosenId      String
  fileUrl      String
  filePublicId String
  fileName     String
  fileType     String
  keterangan   String?
  uploadedAt   DateTime @default(now())
}

model Komentar {
  id          String   @id @default(cuid())
  dokumenId   String
  dokumen     Dokumen  @relation(fields: [dokumenId], references: [id], onDelete: Cascade)
  authorId    String
  isiKomentar String
  createdAt   DateTime @default(now())
}

model Notifikasi {
  id          String    @id @default(cuid())
  pengajuanId String
  pengajuan   Pengajuan @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  userId      String
  pesan       String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
